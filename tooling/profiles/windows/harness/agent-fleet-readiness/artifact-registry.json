      "tracked": false
    },
    {
      "id": "installed-cmd-shim",
      "pathPattern": "%LOCALAPPDATA%\\AgentSwitchboard\\GnhfFleet\\agent-switchboard.cmd",
      "producer": "tooling/gnhf/Start-AgentSwitchboard.ps1",
      "tracked": false
    },
    {
      "id": "startup-readiness-json",
      "pathPattern": "%LOCALAPPDATA%\\AgentSwitchboard\\GnhfFleet\\reports\\startup\\agent-startup-readiness-<timestamp>.json",
      "producer": "tooling/gnhf/Get-AgentSwitchboardStartupReport.ps1",
      "tracked": false
    }
  ],
  "generatedArtifacts": [
