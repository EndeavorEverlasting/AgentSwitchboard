{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/AgentSwitchboard/tooling/profiles/windows/harness/machine-profile/schemas/machine-profile.schema.json",
  "title": "AgentSwitchboard Windows machine profile",
  "type": "object",
  "required": ["schema", "detectedAt", "profileId", "confidence", "identity", "pathConventions", "tools", "signals", "repository", "pathRoles", "reasons", "proofCeiling"],
  "properties": {
    "schema": { "const": "agentswitchboard.machine-profile.v1" },
    "detectedAt": { "type": "string" },
    "profileId": { "enum": ["enterprise-managed-onedrive", "enterprise-managed-local", "work-or-school-onedrive", "personal-onedrive", "local-windows"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "identity": { "type": "object" },
    "pathConventions": { "type": "object" },
    "tools": { "type": "object" },
    "signals": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "repository": { "type": "object", "required": ["expectedOrigin", "candidates", "recommendedRoot", "selectionPolicy"] },
    "pathRoles": {
      "type": "object",
      "required": [
        "profileKey",
        "developmentCheckout",
        "productionUsePath",
        "worktreeRoot",
        "canonicalEntrypoint",
        "openCodeEntrypoint",
        "pathRelation",
        "stableDefaultDevelopmentCheckout"
      ],
      "properties": {
        "profileKey": { "type": "string" },
        "developmentCheckout": { "type": "string" },
        "productionUsePath": { "type": "string" },
        "worktreeRoot": { "type": "string" },
        "canonicalEntrypoint": { "type": "string" },
        "openCodeEntrypoint": { "type": "string" },
        "pathRelation": { "type": "string" },
        "pathRelationNotes": { "type": "string" },
        "stableDefaultDevelopmentCheckout": { "type": "string" },
        "noncanonicalExistingCheckouts": { "type": "array" }
      },
      "additionalProperties": false
    },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "proofCeiling": { "type": "string" }
  },
  "additionalProperties": false
}
