{
  "schema": "agentswitchboard.machine-profile-registry.v1",
  "registryId": "windows-machine-profile-detection",
  "canonicalDetector": "tooling/profiles/windows/Get-AgentSwitchboardMachineProfile.ps1",
  "operationalHarness": "tooling/profiles/windows/harness/machine-profile/manifest.json",
  "environmentRoleRegistry": "tooling/profiles/windows/harness/machine-profile/environment-role.registry.json",
  "profiles": [
    {
      "profileId": "enterprise-managed-onedrive",
      "requiredAny": ["azure-ad-joined", "domain-joined"],
      "requiredAll": ["commercial-onedrive"],
      "repoPolicy": "reuse verified checkout; otherwise use %USERPROFILE%\\dev\\AgentSwitchBoard-Live"
    },
    {
      "profileId": "enterprise-managed-local",
      "requiredAny": ["azure-ad-joined", "domain-joined"],
      "forbidden": ["commercial-onedrive"],
      "repoPolicy": "reuse verified checkout; otherwise use %USERPROFILE%\\dev\\AgentSwitchBoard-Live"
    },
    {
      "profileId": "work-or-school-onedrive",
      "requiredAll": ["commercial-onedrive"],
      "forbidden": ["azure-ad-joined", "domain-joined"],
      "repoPolicy": "treat OneDrive as evidence, not the default checkout root"
    },
    {
      "profileId": "personal-onedrive",
      "requiredAll": ["consumer-onedrive"],
      "forbidden": ["commercial-onedrive", "azure-ad-joined", "domain-joined"],
      "repoPolicy": "treat OneDrive as evidence, not the default checkout root"
    },
    {
      "profileId": "local-windows",
      "fallback": true,
      "repoPolicy": "use %USERPROFILE%\\dev\\AgentSwitchBoard-Live"
    }
  ],
  "precedence": [
    "explicit repo path",
    "AGENT_SWITCHBOARD_REPO",
    "verified machine binding",
    "verified existing checkout candidate",
    "stable user-local dev root"
  ],
  "localEvidenceRoot": "%LOCALAPPDATA%\\AgentSwitchboard\\machine-profile",
  "privacy": "Observed usernames, hostnames, tenant names, environment-role assignments, and resolved paths are local evidence only and must never be committed.",
  "proofCeiling": "Classification and deterministic path-selection contract only; no package, login, provider, or live-runtime proof."
}
