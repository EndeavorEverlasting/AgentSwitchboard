{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/AgentSwitchboard/tooling/profiles/windows/harness/technician-live-cert/schemas/operator-command-contract.schema.json",
  "title": "AgentSwitchboard Operator Command Envelope Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "scope",
    "canonicalOwner",
    "fixturePath",
    "reportTemplate",
    "scanPaths",
    "scanMode",
    "fenceLanguages",
    "rules",
    "sanitization",
    "presentationRequirements",
    "generatedEvidence",
    "proofCeiling"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "agentswitchboard.operator-command-envelope.v1"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "canonicalOwner": {
      "const": "EndeavorEverlasting/AgentSwitchboard"
    },
    "fixturePath": {
      "type": "string",
      "minLength": 1
    },
    "reportTemplate": {
      "type": "string",
      "minLength": 1
    },
    "scanPaths": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scanMode": {
      "const": "markdown-fenced-code"
    },
    "fenceLanguages": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "pattern",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "severity": {
            "const": "error"
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stripPromptPatterns",
        "redactPatterns",
        "maximumExcerptCharacters"
      ],
      "properties": {
        "stripPromptPatterns": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "redactPatterns": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern",
              "replacement"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "replacement": {
                "type": "string"
              }
            }
          }
        },
        "maximumExcerptCharacters": {
          "type": "integer",
          "minimum": 80,
          "maximum": 500
        }
      }
    },
    "presentationRequirements": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generatedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked",
        "defaultRoot",
        "json",
        "markdown"
      ],
      "properties": {
        "tracked": {
          "const": false
        },
        "defaultRoot": {
          "type": "string",
          "minLength": 1
        },
        "json": {
          "const": "operator-command-envelope-report.json"
        },
        "markdown": {
          "const": "operator-command-envelope-report.md"
        }
      }
    },
    "proofCeiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
