{
  "schemaVersion": 1,
  "registryId": "agentswitchboard.technician-live-cert-artifacts.v1",
  "defaultRoot": "%LOCALAPPDATA%/AgentSwitchboard/technician-live-cert",
  "artifacts": [
    {
      "artifactId": "live-cert-run-context",
      "fileName": "runs/<runId>/run.json",
      "generator": "TechnicianLiveCert.Common.psm1",
      "tracked": false,
      "sensitivity": "local-operational",
      "proofCeiling": "declared workstation run identity, Git head, stage state, and evidence root only"
    },
    {
      "artifactId": "stage-result",
      "fileName": "runs/<runId>/<stageId>/stage-result.json",
      "generator": "Invoke-TechnicianLiveCertStage.ps1",
      "tracked": false,
      "sensitivity": "local-operational",
      "proofCeiling": "one stage execution result only"
    },
    {
      "artifactId": "preflight-summary",
      "fileName": "runs/<runId>/P00/preflight-summary.json",
      "generator": "stages/P00-Preflight.ps1",
      "tracked": false,
      "sensitivity": "local-operational",
      "proofCeiling": "P00 workstation prerequisite observation; hosted CI surface mode excludes WSL/Ubuntu runtime"
    },
    {
      "artifactId": "stage-matrix",
      "fileName": "runs/<runId>/technician-live-cert-stage-matrix.csv",
      "generator": "stages/P08-Finalize.ps1",
      "tracked": false,
      "sensitivity": "local-operational",
      "proofCeiling": "P00-P08 stage ledger only"
    },
    {
      "artifactId": "operator-report",
      "fileName": "runs/<runId>/technician-live-cert-report.md",
      "generator": "stages/P08-Finalize.ps1",
      "tracked": false,
      "sensitivity": "local-operational",
      "proofCeiling": "English rendering of observed stage evidence only"
    },
    {
      "artifactId": "harness-status-json",
      "fileName": "harness-status/technician-live-cert-harness-status.json",
      "generator": "tooling/profiles/windows/Get-TechnicianLiveCertHarnessStatus.ps1",
      "tracked": false,
      "sensitivity": "local-operational",
      "proofCeiling": "tracked component, known-guard, and validator readiness only"
    },
    {
      "artifactId": "harness-status-report",
      "fileName": "harness-status/technician-live-cert-harness-status.md",
      "generator": "tooling/profiles/windows/Get-TechnicianLiveCertHarnessStatus.ps1",
      "tracked": false,
      "sensitivity": "local-operational",
      "proofCeiling": "English rendering of harness readiness only"
    }
  ],
  "namingConventions": {
    "runId": "UTC basic timestamp plus random suffix",
    "stageDirectory": "<runId>/<stageId>",
    "statusArtifacts": "stable names under harness-status; newest run overwrites only when the operator selects the same output root"
  },
  "forbidden": [
    "Do not commit generated live-cert evidence.",
    "Do not include credentials, browser tokens, private endpoints, or unredacted private hostnames in tracked fixtures.",
    "Do not treat a status report as live workstation proof."
  ]
}
