  "knownFailureGuards": [
    {
      "id": "ambiguous-dotnet-overload",
      "forbiddenPattern": ".Replace([char]0, '')",
      "requiredPattern": ".Replace(([char]0).ToString(), [string]::Empty)",
      "proof": "static source assertion plus executable NUL-padded Ubuntu normalization"
    },
    {
      "id": "psscriptroot-param-default",
      "forbiddenPattern": "[string]$RootPath = (Split-Path -Parent $PSScriptRoot)",
