    },
    {
      "id": "hosted-ci-proof-inflation",
      "guard": "TECHNICIAN_LIVE_CERT_CI_SURFACE may prove CMD dispatch only and may not claim initialized WSL/Ubuntu runtime"
    },
    {
      "id": "interactive-git-pager",
      "guard": "All harness Git inspection uses git --no-pager and propagates nonzero exit codes"
    },
    {
      "id": "live-failure-overridden-by-static-pass",
      "guard": "Observed operator failure remains blocking until the exact command is rerun successfully"
    }
  ],
  "validationOrder": [
    "python -m unittest tests.test_technician_live_cert_harness",
    "python -m unittest tests.test_technician_live_cert_surface",
    "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/Test-TechnicianLiveCertSurface.ps1",
