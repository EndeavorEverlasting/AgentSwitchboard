    {"id":"interactive-git-pager","guard":"All harness Git inspection uses git --no-pager and propagates nonzero exit codes."},
    {"id":"live-failure-overridden-by-static-pass","guard":"Observed operator failure remains blocking until the exact repository-owned command is rerun successfully."}
