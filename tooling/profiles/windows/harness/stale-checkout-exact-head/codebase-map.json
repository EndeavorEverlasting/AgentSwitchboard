    {"path": "tooling/profiles/windows/harness/stale-checkout-exact-head", "purpose": "Focused map, registry, workflow, schema, fixture, and report contract"},
    {"path": "tooling/profiles/windows/hooks", "purpose": "Opt-in staged-change validation"},
    {"path": ".ai/skills/stale-checkout-exact-head-bootstrap", "purpose": "Reusable trigger and operating procedure"},
    {"path": "docs/harness", "purpose": "Human-readable operator guidance"},
    {"path": "tests", "purpose": "Dependency-free structural and safety contracts"}
  ],
  "entrypoints": [
    "Bootstrap-Technician-ExactHead.cmd",
    "scripts/Invoke-StaleCheckoutExactHeadBootstrap.ps1",
    "scripts/Test-StaleCheckoutExactHeadBootstrap.ps1",
    "tooling/profiles/windows/Get-StaleCheckoutExactHeadHarnessStatus.ps1"
