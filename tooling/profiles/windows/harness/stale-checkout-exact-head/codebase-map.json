    "validateWindowsPowerShell": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/Test-StaleCheckoutExactHeadBootstrap.ps1",
    "status": "pwsh -NoLogo -NoProfile -File tooling/profiles/windows/Get-StaleCheckoutExactHeadHarnessStatus.ps1",
    "field": "Bootstrap-Technician-ExactHead.cmd -SourceRepository <path> -RemoteRef <ref> -ExpectedHead <sha> -Mode ready"
