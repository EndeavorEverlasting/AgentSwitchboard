{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/AgentSwitchboard/tooling/comms/schemas/comms-project-adapter.v1.schema.json",
  "title": "CommsCompiler project adapter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adapterId",
    "project",
    "authority",
    "intents",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agentswitchboard.comms-project-adapter/v1"
    },
    "adapterId": {
      "type": "string",
      "minLength": 3
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "aliases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "sources"
      ],
      "properties": {
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "locator"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "locator": {
              "type": "string",
              "pattern": "^logical://"
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "authority",
              "locator"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "authority": {
                "type": "string"
              },
              "locator": {
                "type": "string",
                "pattern": "^logical://"
              }
            }
          }
        }
      }
    },
    "intents": {
      "type": "object",
      "minProperties": 1
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackedAdapterMayContainLiveIdentifiers",
        "trackedFixturesMustBeSynthetic"
      ],
      "properties": {
        "trackedAdapterMayContainLiveIdentifiers": {
          "const": false
        },
        "trackedFixturesMustBeSynthetic": {
          "const": true
        }
      }
    }
  }
}
