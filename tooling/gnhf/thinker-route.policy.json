{
  "schema": "agentswitchboard.thinker-route-policy.v1",
  "defaultMode": "standard",
  "purpose": "Select exactly one read-only thinker deterministically, then hand a bounded plan artifact to downstream builders without replaying the full source conversation.",
  "chains": {
    "standard": [
      "claude",
      "codex",
      "deepseek",
      "opencode-muse",
      "opencode-nemotron",
      "opencode-big-pickle"
    ],
    "free": [
      "opencode-muse",
      "opencode-nemotron",
      "opencode-big-pickle"
    ]
  },
  "routes": [
    {
      "id": "claude",
      "label": "Claude Code",
      "command": "claude",
      "runner": "claude-print",
      "provider": "anthropic",
      "model": null,
      "probeProvider": null,
      "costClass": "subscription-or-metered",
      "readOnlyContract": "permission-mode-plan-no-session-persistence"
    },
    {
      "id": "codex",
      "label": "Codex CLI",
      "command": "codex",
      "runner": "codex-exec",
      "provider": "openai",
      "model": null,
      "probeProvider": null,
      "costClass": "subscription-or-metered",
      "readOnlyContract": "exec-read-only-ephemeral"
    },
    {
      "id": "deepseek",
      "label": "DeepSeek through OpenCode",
      "command": "opencode",
      "runner": "opencode-run",
      "provider": "deepseek",
      "model": "deepseek/deepseek-v4-pro",
      "probeProvider": "deepseek",
      "costClass": "metered",
      "readOnlyContract": "inline-deny-mutation-config"
    },
    {
      "id": "opencode-muse",
      "label": "OpenCode Muse Spark contributor free",
      "command": "opencode",
      "runner": "opencode-run",
      "provider": "opencode",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "probeProvider": "opencode",
      "costClass": "free",
      "readOnlyContract": "inline-deny-mutation-config"
    },
    {
      "id": "opencode-nemotron",
      "label": "OpenCode Nemotron 3 Ultra free",
      "command": "opencode",
      "runner": "opencode-run",
      "provider": "opencode",
      "model": "opencode/nemotron-3-ultra-free",
      "probeProvider": "opencode",
      "costClass": "free",
      "readOnlyContract": "inline-deny-mutation-config"
    },
    {
      "id": "opencode-big-pickle",
      "label": "OpenCode Big Pickle free fallback",
      "command": "opencode",
      "runner": "opencode-run",
      "provider": "opencode",
      "model": "opencode/big-pickle",
      "probeProvider": "opencode",
      "costClass": "free",
      "readOnlyContract": "inline-deny-mutation-config"
    }
  ]
}
