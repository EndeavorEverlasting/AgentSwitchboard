{
  "schemaVersion": 2,
  "harnessId": "agentswitchboard.opencode-lsp-workstation-setup.v1",
  "tracked": false,
  "defaultRunRoot": "%LOCALAPPDATA%/AgentSwitchboard/opencode-lsp/runs/<run-id>",
  "configurationArtifactsImmutable": true,
  "artifacts": [
    {"artifactId":"setup-json","fileName":"opencode-lsp-setup.json","purpose":"machine-readable exact Git/OpenCode/setup state"},
    {"artifactId":"operator-report","fileName":"opencode-lsp-operator-report.md","purpose":"human-readable working/broken/missing/next-action report"},
    {"artifactId":"lsp-overlay","fileName":"opencode-lsp.overlay.json","purpose":"run-specific immutable OpenCode fallback config containing lsp=true"},
    {"artifactId":"launcher-script","fileName":"Open-AgentSwitchboard-OpenCode-Lsp.ps1","purpose":"run-specific immutable launcher that preserves inherited config in memory and forces lsp=true"},
    {"artifactId":"launcher","fileName":"Open-AgentSwitchboard-OpenCode-Lsp.cmd","purpose":"run-specific immutable CMD front door for the PowerShell launcher"}
  ],
  "naming": {"runId":"yyyyMMddTHHmmssZ-8hex","files":"fixed canonical names inside one immutable run directory"},
  "forbiddenContents": ["API keys","OAuth tokens","passwords","cookies","customer data","private hostnames","full environment dumps","clipboard contents","private source text","OPENCODE_CONFIG_CONTENT contents"]
}
