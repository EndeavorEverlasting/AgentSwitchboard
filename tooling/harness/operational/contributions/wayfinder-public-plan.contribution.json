  "capabilitiesDonated": [
    "Choose Wayfinder only when unresolved fog prevents a safe bounded route.",
    "Chart tracker-backed maps whose child tickets own exact decisions.",
    "Treat research/prototype/grilling/task labels as workflow gates.",
    "Preserve prototype logic/UI and domain glossary/ADR companion procedures.",
    "Bind one Python interpreter across dependency installation and nested PowerShell validation.",
    "Use blocker and assignee state for a concurrency-safe frontier.",
    "Stop chart mode before non-research resolution.",
    "Synthesize a temporary spec only after decision/fog clearance.",
    "Retain durable decision history after spec retirement."
  ],
  "compatibility": {
    "consumerContract": "agentswitchboard.wayfinder.v1+public-plan-mirror-1",
    "minimumSkillVersion": "1.0.0",
    "changeKind": "additive",
