{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/AgentSwitchboard/tooling/harness/operational/contributions/cross-repository-contribution.schema.json",
  "title": "AgentSwitchboard Cross-Repository Contribution Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contributionId",
    "status",
    "donor",
    "consumer",
    "classifications",
    "capabilitiesDonated",
    "compatibility",
    "proofCeiling",
    "mustNotCopyOrReimplement",
    "validation"
  ],
  "properties": {
    "schema": { "const": "agentswitchboard.cross-repository-contribution.v1" },
    "contributionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,100}$" },
    "status": { "enum": ["proposed", "adopted", "superseded", "retired"] },
    "donor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "license", "authoritativePaths"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "path"],
          "properties": {
            "spdx": { "type": "string", "minLength": 2 },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        "authoritativePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "blobSha"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "blobSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          }
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "targetLayer", "canonicalOwner", "files"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "targetLayer": { "type": "string", "minLength": 3 },
        "canonicalOwner": { "type": "string", "minLength": 3 },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "classification", "disposition", "consumerOwner", "notes"],
        "properties": {
          "candidate": { "type": "string", "minLength": 3 },
          "classification": {
            "enum": [
              "portable-harness",
              "reusable-skill",
              "shared-schema-or-evidence-packet",
              "adapter",
              "reference-only-doctrine",
              "domain-specific-rejected"
            ]
          },
          "disposition": { "enum": ["adopt", "reference", "reject"] },
          "consumerOwner": { "type": ["string", "null"] },
          "notes": { "type": "string", "minLength": 3 }
        }
      }
    },
    "capabilitiesDonated": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumerContract", "minimumSkillVersion", "changeKind", "staleReferencePolicy", "autoAdvanceDonor"],
      "properties": {
        "consumerContract": { "type": "string", "minLength": 3 },
        "minimumSkillVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "changeKind": { "enum": ["additive", "breaking"] },
        "staleReferencePolicy": { "enum": ["pin-until-reviewed", "fail-if-upstream-moves"] },
        "autoAdvanceDonor": { "const": false }
      }
    },
    "proofCeiling": { "type": "string", "minLength": 20 },
    "mustNotCopyOrReimplement": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "validation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
  }
}
