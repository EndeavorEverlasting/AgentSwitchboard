{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentswitchboard.dispatch-receipt/v1",
  "title": "Triage Lane Dispatch Receipt",
  "description": "Machine-readable receipt recording dispatch attempt of a Triage lane to an ASB adapter",
  "type": "object",
  "required": [
    "receipt_version",
    "lane_id",
    "adapter_kind",
    "dispatch_status",
    "timestamp"
  ],
  "properties": {
    "receipt_version": {
      "type": "string",
      "const": "v1"
    },
    "lane_id": {
      "type": "string",
      "minLength": 1
    },
    "lane_mission": {
      "type": "string"
    },
    "adapter_kind": {
      "type": "string",
      "enum": [
        "public-plan",
        "cursor-cloud-agent",
        "local-argv",
        "runtime-tool",
        "unmapped"
      ]
    },
    "dispatch_status": {
      "type": "string",
      "enum": [
        "DISPATCHED",
        "EXECUTED",
        "BLOCKED_UNSUPPORTED",
        "BLOCKED_MISSING_ADAPTER",
        "BLOCKED_POLICY_VIOLATION",
        "BLOCKED_HOST",
        "BLOCKED_API",
        "FAILED"
      ],
      "description": "Dispatch execution status. EXECUTED = successful completion. FAILED = non-zero exit or error. BLOCKED_* = cannot execute due to missing infrastructure. Cloud agent EXECUTED includes cloudAgentBcId in execution_details."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "exit_code": {
      "type": "integer"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autonomy_gap": {
      "type": "object",
      "properties": {
        "gap_detected": {
          "type": "boolean"
        },
        "gap_reason": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        }
      }
    },
    "blocking_reason": {
      "type": "string"
    },
    "execution_details": {
      "type": "object",
      "description": "Adapter-specific execution details. For local-argv: argv, stdout, stderr, duration_ms. For cursor-cloud-agent: cloud_agent_id, dashboard_url, duration_ms, subagent_duration_seconds.",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "duration_ms": {
          "type": "number"
        },
        "cloud_agent_id": {
          "type": "string"
        },
        "dashboard_url": {
          "type": "string"
        },
        "subagent_duration_seconds": {
          "type": "number"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "descriptor": {
      "type": "object",
      "description": "ASB execution descriptor details"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter_kind": {
            "const": "cursor-cloud-agent"
          },
          "dispatch_status": {
            "const": "EXECUTED"
          }
        },
        "required": [
          "adapter_kind",
          "dispatch_status"
        ]
      },
      "then": {
        "required": [
          "execution_details"
        ],
        "properties": {
          "execution_details": {
            "type": "object",
            "required": [
              "cloud_agent_id",
              "dashboard_url"
            ],
            "properties": {
              "cloud_agent_id": {
                "type": "string",
                "minLength": 1
              },
              "dashboard_url": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
