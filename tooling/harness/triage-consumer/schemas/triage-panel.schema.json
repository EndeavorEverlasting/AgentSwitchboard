{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentswitchboard.triage-panel/v1",
  "title": "Triage Panel Transport Artifact",
  "description": "ASB consumer schema for Triage panel/lane-prompt transport artifacts (portability fallback)",
  "type": "object",
  "required": ["panel_id", "lane_id", "sprint_name", "repo", "branch", "mission", "owned_scope", "forbidden_scope", "expected_artifacts", "validation_order", "prompt_content"],
  "properties": {
    "panel_id": {"type": "string", "minLength": 1},
    "lane_id": {"type": "string", "minLength": 1},
    "sprint_name": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "branch": {"type": "string"},
    "mission": {"type": "string", "minLength": 1},
    "owned_scope": {
      "type": "array",
      "items": {"type": "string"}
    },
    "forbidden_scope": {
      "type": "array",
      "items": {"type": "string"}
    },
    "expected_artifacts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "validation_order": {
      "type": "array",
      "items": {"type": "string"}
    },
    "prompt_content": {"type": "string", "minLength": 1},
    "dependencies": {
      "type": "array",
      "items": {"type": "string"}
    },
    "wave": {"type": "integer", "minimum": 1}
  }
}
