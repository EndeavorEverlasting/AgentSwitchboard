{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/AgentSwitchboard/tooling/harness/wayfinder/schemas/spec.schema.json",
  "title": "AgentSwitchboard Wayfinder Temporary Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "sourceMap", "decisionSources", "problemStatement", "solution", "userStories", "implementationDecisions", "testingDecisions", "outOfScope", "furtherNotes", "lifecycle", "status", "primaryDecisionAuthority"],
  "properties": {
    "schema": {"const": "agentswitchboard.wayfinder-spec.v1"},
    "title": {"type": "string", "minLength": 3},
    "sourceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "ref"],
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "decisionSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "ref"],
        "properties": {
          "title": {"type": "string", "minLength": 3},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "problemStatement": {"type": "string", "minLength": 3},
    "solution": {"type": "string", "minLength": 3},
    "userStories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "implementationDecisions": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "testingDecisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "outOfScope": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "furtherNotes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "lifecycle": {"const": "temporary-until-implementation"},
    "status": {"enum": ["draft", "ready-for-agent", "implemented", "retired"]},
    "primaryDecisionAuthority": {"const": "tracker-decision-tickets"}
  }
}
