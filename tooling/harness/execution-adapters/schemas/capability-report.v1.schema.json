{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/AgentSwitchboard/tooling/harness/execution-adapters/schemas/capability-report.v1.schema.json",
  "title": "AgentSwitchboard Execution Adapter Capability Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "probeId",
    "adapterKind",
    "status",
    "observedAt",
    "nativeHarness",
    "readiness",
    "capabilities",
    "blocker",
    "proofCeiling"
  ],
  "properties": {
    "schema": {
      "const": "agentswitchboard.execution-capability-report/v1"
    },
    "probeId": {
      "type": "string",
      "pattern": "^probe_[A-Za-z0-9._-]{8,128}$"
    },
    "adapterKind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "status": {
      "enum": [
        "READY",
        "BLOCKED",
        "UNSUPPORTED"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "nativeHarness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "binary",
        "auth",
        "transport",
        "dispatch"
      ],
      "properties": {
        "host": {
          "enum": [
            "READY",
            "BLOCKED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "binary": {
          "enum": [
            "READY",
            "BLOCKED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "auth": {
          "enum": [
            "READY",
            "BLOCKED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "transport": {
          "enum": [
            "READY",
            "BLOCKED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "dispatch": {
          "enum": [
            "READY",
            "BLOCKED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation",
        "structuredOutput",
        "executionIdentity",
        "remoteExecution",
        "timeoutControl"
      ],
      "properties": {
        "mutation": {
          "type": "boolean"
        },
        "structuredOutput": {
          "type": "boolean"
        },
        "executionIdentity": {
          "type": "boolean"
        },
        "remoteExecution": {
          "type": "boolean"
        },
        "timeoutControl": {
          "type": "boolean"
        }
      }
    },
    "blocker": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "enum": [
                "BLOCKED_HOST",
                "BLOCKED_BINARY",
                "BLOCKED_AUTH",
                "BLOCKED_API",
                "BLOCKED_POLICY",
                "BLOCKED_INPUT",
                "BLOCKED_UNSUPPORTED"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "proofCeiling": {
      "const": "CAPABILITY_PROBE_ONLY"
    }
  }
}
