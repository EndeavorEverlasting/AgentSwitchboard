{
  "schemaVersion": 1,
  "manifestId": "agentswitchboard.automated-test-floor.v1",
  "title": "AgentSwitchboard automated test floor",
  "proofLevel": "static-test",
  "proofCeiling": "Dependency-free static and synthetic contract proof only. Does not prove runtime, live-target, provider delivery, merge, release, or deployment.",
  "canonicalCommand": "pwsh -NoLogo -NoProfile -File scripts/Test-AutomatedTestFloor.ps1",
  "determinism": {
    "pythonHashSeed": "0",
    "timezone": "UTC",
    "networkAllowed": false,
    "mutationAllowed": false,
    "randomSeedPolicy": "unset; floor gates must not depend on wall-clock ordering beyond isolated temp roots"
  },
  "failClosed": {
    "zeroRequiredGates": true,
    "zeroUnittestCases": true,
    "missingRequiredPath": true,
    "skipMustNotCountAsPass": true,
    "falseGreenUnittestDiscoverForbidden": true
  },
  "notes": [
    "Many tests/*.py files are script-style entrypoints (python tests/foo.py), not unittest modules.",
    "python -m unittest discover can report green while silently contributing zero cases from script-style modules; this floor forbids that.",
    "Path-filtered domain workflows remain owners for deep domain proof; this floor is the always-on unattended safety net."
  ],
  "gates": [
    {
      "id": "public-plan-script",
      "runner": "python-script",
      "path": "tests/test_public_plan_contracts.py",
      "required": true,
      "platforms": ["windows", "linux", "macos"],
      "expectStdoutContains": ["PASS"],
      "proof": "public plan registry and startup readiness structure"
    },
    {
      "id": "runtime-event-script",
      "runner": "python-script",
      "path": "tests/test_runtime_event_contract.py",
      "required": true,
      "platforms": ["windows", "linux", "macos"],
      "expectStdoutContains": ["PASS"],
      "proof": "runtime-event static topology and synthetic causality fixtures"
    },
    {
      "id": "device-profile-script",
      "runner": "python-script",
      "path": "tests/test_device_profile_launcher_contract.py",
      "required": true,
      "platforms": ["windows", "linux", "macos"],
      "expectStdoutContains": ["PASS"],
      "proof": "canonical device-profile launcher contracts"
    },
    {
      "id": "app-harness-script",
      "runner": "python-script",
      "path": "tests/test_app_harness_validator.py",
      "required": true,
      "platforms": ["windows", "linux", "macos"],
      "expectStdoutContains": ["PASS"],
      "proof": "one-command offline app harness validator contracts"
    },
    {
      "id": "exact-grounding-script",
      "runner": "python-script",
      "path": "tests/test_exact_grounding_gate.py",
      "required": true,
      "platforms": ["windows", "linux", "macos"],
      "expectStdoutContains": ["PASS"],
      "proof": "fail-closed exact-output grounding fixtures"
    },
    {
      "id": "harness-infrastructure-script",
      "runner": "python-script",
      "path": "tests/test_harness_infrastructure_completeness.py",
      "required": true,
      "platforms": ["windows", "linux", "macos"],
      "expectStdoutContains": ["PASS"],
      "proof": "tracked harness infrastructure completeness"
    },
    {
      "id": "operational-harness-script",
      "runner": "python-script",
      "path": "tests/test_operational_harness.py",
      "required": true,
      "platforms": ["windows", "linux", "macos"],
      "expectStdoutContains": ["PASS"],
      "proof": "operational harness completeness and routing contracts"
    },
    {
      "id": "progressive-disclosure-unittest",
      "runner": "python-unittest",
      "modules": ["tests.test_progressive_disclosure_harness"],
      "required": true,
      "platforms": ["windows", "linux", "macos"],
      "minTests": 1,
      "proof": "progressive disclosure context routing contracts"
    },
    {
      "id": "repository-work-ledger-unittest",
      "runner": "python-unittest",
      "modules": [
        "tests.test_repository_work_ledger_contract",
        "tests.test_repository_work_ledger_frontier"
      ],
      "required": true,
      "platforms": ["windows", "linux", "macos"],
      "minTests": 1,
      "proof": "repository work ledger contract and frontier"
    },
    {
      "id": "agent-documentation-pwsh",
      "runner": "pwsh-file",
      "path": "scripts/Test-AgentDocumentationContract.ps1",
      "required": true,
      "platforms": ["windows", "linux"],
      "proof": "agent documentation and adapter contract"
    },
    {
      "id": "public-plan-pwsh",
      "runner": "pwsh-file",
      "path": "scripts/Test-PublicPlanContracts.ps1",
      "required": true,
      "platforms": ["windows", "linux"],
      "proof": "PowerShell public-plan validator"
    },
    {
      "id": "runtime-event-pwsh",
      "runner": "pwsh-file",
      "path": "scripts/Test-RuntimeEventContract.ps1",
      "required": true,
      "platforms": ["windows", "linux"],
      "proof": "PowerShell runtime-event validator"
    },
    {
      "id": "harness-doctrine-pwsh",
      "runner": "pwsh-file",
      "path": "scripts/Test-HarnessDoctrineContract.ps1",
      "required": true,
      "platforms": ["windows", "linux"],
      "proof": "harness doctrine contract"
    }
  ]
}
