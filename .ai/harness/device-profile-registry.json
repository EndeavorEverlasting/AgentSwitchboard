{
  "schema": "agentswitchboard.device-profile-registry.v1",
  "registryId": "agentswitchboard.device-profiles.v1",
  "canonicalOwner": "EndeavorEverlasting/AgentSwitchboard",
  "profiles": [
    {
      "profileId": "windows",
      "displayName": "Windows Profile",
      "status": "contract-only",
      "ownerRepository": "EndeavorEverlasting/AgentSwitchboard",
      "canonicalOperation": "open-or-activate",
      "frontend": "wezterm",
      "implementationSeparate": true,
      "configurationMayDiffer": false,
      "canonicalSourcePath": "tooling/profiles/windows/Invoke-AgentSwitchboardOpenOrActivate.ps1",
      "installedPath": "%LOCALAPPDATA%\\AgentSwitchboard\\profiles\\windows\\Invoke-AgentSwitchboardOpenOrActivate.ps1",
      "consumers": [
        {
          "repository": "EndeavorEverlasting/SysAdminSuite",
          "role": "consumer-certifier",
          "delegateOnly": true,
          "rawFallbackAllowed": false
        }
      ]
    },
    {
      "profileId": "linux",
      "displayName": "Linux Profile",
      "status": "reserved",
      "ownerRepository": "EndeavorEverlasting/AgentSwitchboard",
      "canonicalOperation": "open-or-activate",
      "frontend": "profile-defined",
      "implementationSeparate": true,
      "configurationMayDiffer": true,
      "canonicalSourcePath": null,
      "installedPath": null,
      "consumers": []
    },
    {
      "profileId": "android",
      "displayName": "Android Profile",
      "status": "repository-implemented",
      "ownerRepository": "EndeavorEverlasting/AgentSwitchboard",
      "canonicalOperation": "open-or-activate",
      "frontend": "termux",
      "implementationSeparate": true,
      "configurationMayDiffer": true,
      "canonicalSourcePath": "tooling/profiles/android/Invoke-AgentSwitchboardOpenOrActivate.sh",
      "installedPath": "$PREFIX/bin/agentswitchboard-phone",
      "bootstrapPath": "Bootstrap-AgentSwitchboard-Termux.sh",
      "workspaceBackend": "tmux",
      "continuityTransport": "ssh",
      "localEvidencePath": "${XDG_STATE_HOME:-$HOME/.local/state}/agentswitchboard/android",
      "consumers": []
    }
  ],
  "proofCeiling": "The registry proves profile names, ownership, delegation rules, platform separation, and the tracked Android Termux/tmux/SSH implementation paths. It does not prove Termux is installed on a phone, packages were installed, SSH authentication succeeded, a local or remote tmux workspace opened or activated, Android process persistence, Windows or Linux runtime behavior, or operator acceptance."
}
