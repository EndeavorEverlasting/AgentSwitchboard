{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EndeavorEverlasting/AgentSwitchboard/.ai/harness/schemas/fm-asb-promptkit/prompt-dispatch.v1.schema.json",
  "title": "ASB Prompt Dispatch v1",
  "allOf": [
    {
      "$ref": "protocol-envelope.v1.schema.json"
    },
    {
      "type": "object",
      "required": [
        "schema",
        "routingDecisionEventId",
        "target",
        "prompt",
        "resolvedVariables",
        "instructionPacket",
        "authority",
        "delivery",
        "expectedResult"
      ],
      "properties": {
        "schema": {
          "const": "asb.prompt-dispatch/v1"
        },
        "routingDecisionEventId": {
          "$ref": "protocol-envelope.v1.schema.json#/$defs/eventId"
        },
        "target": {
          "type": "object",
          "required": [
            "firstMateTaskId",
            "deliveryPlane"
          ],
          "properties": {
            "firstMateTaskId": {
              "$ref": "protocol-envelope.v1.schema.json#/$defs/firstMateTaskId"
            },
            "expectedGeneration": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "deliveryPlane": {
              "const": "durable-inbox"
            }
          },
          "additionalProperties": false
        },
        "prompt": {
          "type": "object",
          "required": [
            "ref",
            "deliveryMode",
            "inlineText"
          ],
          "properties": {
            "ref": {
              "$ref": "protocol-envelope.v1.schema.json#/$defs/promptRef"
            },
            "deliveryMode": {
              "enum": [
                "reference",
                "inline"
              ]
            },
            "inlineText": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 20000
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "deliveryMode": {
                    "const": "reference"
                  }
                },
                "required": [
                  "deliveryMode"
                ]
              },
              "then": {
                "properties": {
                  "inlineText": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "deliveryMode": {
                    "const": "inline"
                  }
                },
                "required": [
                  "deliveryMode"
                ]
              },
              "then": {
                "properties": {
                  "inlineText": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "resolvedVariables": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "instructionPacket": {
          "type": "object",
          "required": [
            "summary",
            "proofGate",
            "evidenceRefs"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "proofGate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "evidenceRefs": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "protocol-envelope.v1.schema.json#/$defs/evidenceRef"
              }
            }
          },
          "additionalProperties": false
        },
        "authority": {
          "type": "object",
          "required": [
            "allowMutation",
            "allowedScopes",
            "forbiddenScopes"
          ],
          "properties": {
            "allowMutation": {
              "type": "boolean"
            },
            "allowedScopes": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 240
              }
            },
            "forbiddenScopes": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 240
              }
            }
          },
          "additionalProperties": false
        },
        "delivery": {
          "type": "object",
          "required": [
            "deliveryId",
            "expectsReply",
            "resolveKeys"
          ],
          "properties": {
            "deliveryId": {
              "type": "string",
              "pattern": "^[a-f0-9]{16,64}$"
            },
            "expectsReply": {
              "type": "boolean"
            },
            "resolveKeys": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 128
              }
            }
          },
          "additionalProperties": false
        },
        "expectedResult": {
          "type": "object",
          "required": [
            "acceptedStates",
            "coordinatorValidationRequired"
          ],
          "properties": {
            "acceptedStates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "running",
                  "needs-decision",
                  "blocked",
                  "completed",
                  "failed"
                ]
              }
            },
            "coordinatorValidationRequired": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      },
      "unevaluatedProperties": false
    }
  ]
}
